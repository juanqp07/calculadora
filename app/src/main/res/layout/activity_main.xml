<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8431A"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPantalla"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="#F0EEEC"
            android:gravity="center_vertical|end"
            android:padding="12dp"
            android:text="0"
            android:textColor="#000000"
            android:textSize="36sp" />

        <Button
            android:id="@+id/btnDel"
            android:layout_width="80dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="DEL"
            android:textColor="#000000"
            android:textSize="18sp"
            app:backgroundTint="#3AB5A0"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAC"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="AC"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#8FCB1F"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnMasMenos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="+/-"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#8FCB1F"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnPorcentaje"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="%"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#8FCB1F"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnDividir"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="/"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#8FCB1F"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="7"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="8"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="9"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnMultiplicar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="X"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#8FCB1F"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="4"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="5"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="6"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnRestar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="-"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#8FCB1F"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="3"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="2"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="1"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnSumar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="+"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#8FCB1F"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="0"
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnComa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text=","
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#DDD800"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnIgual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="="
            android:textColor="#000000"
            android:textSize="22sp"
            app:backgroundTint="#8FCB1F"
            app:cornerRadius="16dp" />
    </LinearLayout>

</LinearLayout>